                  "    const o = pm.response.json();",
                  "    pm.expect(o.id).to.be.above(10000);",
                  "    pm.expect(o.customer.id).to.eql(Number(pm.collectionVariables.get('customerId')));",
                  "});"
                ]
              }
            }
          ]
        },
