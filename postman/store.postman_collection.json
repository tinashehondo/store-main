            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is a plain JSON array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('X-Total-Count header is a number', () => pm.expect(Number(pm.response.headers.get('X-Total-Count'))).to.be.at.least(0));",
                  "pm.test('Link header has first and last', () => {",
                  "    const links = parseLinks(pm.response.headers.get('Link'));",
                  "    pm.expect(links).to.have.property('first');",
                  "    pm.expect(links).to.have.property('last');",
                  "});",
                  "pm.test('middle page has prev and next links', () => {",
                  "    const links = parseLinks(pm.response.headers.get('Link'));",
                  "    pm.expect(links.prev).to.include('page=0&size=10');",
                  "    pm.expect(links.next).to.include('page=2&size=10');",
                  "});"
                ]
              }
            }
          ]
