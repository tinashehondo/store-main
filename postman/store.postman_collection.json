                  "    pm.expect(links).to.have.property('last');",
                  "});",
                  "pm.test('default page size is 20, ordered by id', () => {",
                  "    const ids = pm.response.json().map(o => o.id);",
                  "    pm.expect(ids.length).to.be.at.most(20);",
