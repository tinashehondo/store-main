              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is a plain JSON array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('X-Total-Count header is a number', () => pm.expect(Number(pm.response.headers.get('X-Total-Count'))).to.be.at.least(0));",
