{
  "info": {
    "name": "Store (local)",
    "description": "Requests and checks for the store API running locally (./gradlew bootRun on port 8080, seeded with the demo data). Run the whole collection with the Collection Runner, or send requests one by one. Change baseUrl in the collection variables to target another host.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helper: parses an RFC 8288 Link header into { rel: url }.",
          "parseLinks = function (header) {",
          "    const links = {};",
          "    (header || '').split(',').forEach(part => {",
          "        const m = part.match(/<([^>]*)>\\s*;\\s*rel=\"([^\"]+)\"/);",
          "        if (m) { links[m[2]] = m[1]; }",
          "    });",
          "    return links;",
          "};"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Shared helper: parses an RFC 8288 Link header into { rel: url }.",
          "parseLinks = function (header) {",
          "    const links = {};",
          "    (header || '').split(',').forEach(part => {",
          "        const m = part.match(/<([^>]*)>\\s*;\\s*rel=\"([^\"]+)\"/);",
          "        if (m) { links[m[2]] = m[1]; }",
          "    });",
          "    return links;",
          "};"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "ordersLastPageUrl",
      "value": "http://localhost:8080/order?page=0&size=20"
    }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get customers (default page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer"
              ]
            },
            "description": "First page of customers with their embedded orders. Paging metadata is in the X-Total-Count and Link headers."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is a plain JSON array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('X-Total-Count header is a number', () => pm.expect(Number(pm.response.headers.get('X-Total-Count'))).to.be.at.least(0));",
                  "pm.test('Link header has first and last', () => {",
                  "    const links = parseLinks(pm.response.headers.get('Link'));",
                  "    pm.expect(links).to.have.property('first');",
                  "    pm.expect(links).to.have.property('last');",
                  "});",
                  "pm.test('default page size is 20, ordered by id', () => {",
                  "    const ids = pm.response.json().map(c => c.id);",
                  "    pm.expect(ids.length).to.be.at.most(20);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => a - b));",
                  "});",
                  "pm.test('first page has no prev link', () => pm.expect(parseLinks(pm.response.headers.get('Link'))).to.not.have.property('prev'));",
                  "pm.test('customer shape is {id, name, orders[{id, description}]}', () => {",
                  "    const c = pm.response.json()[0];",
                  "    pm.expect(Object.keys(c)).to.have.members(['id', 'name', 'orders']);",
                  "    if (c.orders.length) { pm.expect(Object.keys(c.orders[0])).to.have.members(['id', 'description']); }",
                  "});"
                ]
              }
            }
          ]
        },
